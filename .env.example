# Ride AI Platform — Environment Variable Configuration
# Copy this file to .env for local development

# ==================================================
# 1. FASTAPI BACKEND SERVICE CONFIGURATION
# ==================================================
PORT=8000
DATABASE_URL=sqlite:///./ride_ai.db

# JWT Security Credentials (Replace with strong secret in production)
JWT_SECRET_KEY=your_secure_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================================================
# 2. LLM SERVICE & OLLAMA COPILOT CONFIGURATION
# ==================================================
LLM_SERVICE_PORT=8001
LLM_SERVICE_URL=http://localhost:8001
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# ==================================================
# 3. REACT FRONTEND CONFIGURATION
# ==================================================
# Use /api for Nginx reverse-proxy setup (default in Docker execution)
# Use http://localhost:8000 for direct standalone frontend local dev
VITE_API_BASE_URL=/api

# ==================================================
# 4. CONTAINER EXPOSED HOST PORTS
# ==================================================
FRONTEND_PORT=3000
BACKEND_PORT=8000
