# Ride AI Monorepo Environment Configuration

# Backend Service Configuration
PORT=8000
DATABASE_URL=sqlite:///./ride_ai.db

# Ollama LLM Service Configuration
# Use http://llm-service:11434 when running inside Docker Compose network
# Use http://localhost:11434 when running backend directly on host against host Ollama
OLLAMA_HOST=http://llm-service:11434
OLLAMA_MODEL=gemma2

# Frontend Service Configuration
# Use /api for Nginx reverse-proxy setup (default in Docker)
# Use http://localhost:8000 for direct API calls in local dev
VITE_API_BASE_URL=/api

# Container Exposed Host Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
LLM_PORT=11435
