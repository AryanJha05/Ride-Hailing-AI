# Ride AI Monorepo Environment Configuration

# Backend Service Configuration
PORT=8000
DATABASE_URL=sqlite:///./ride_ai.db

# JWT Security Configuration (Do NOT place real production secrets here)
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Service Configuration
# Use /api for Nginx reverse-proxy setup (default in Docker)
# Use http://localhost:8000 for direct API calls in local dev
VITE_API_BASE_URL=/api

# Container Exposed Host Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
